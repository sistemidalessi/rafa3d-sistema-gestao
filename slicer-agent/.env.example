# Copie este arquivo para ".env" (sem ".example") e preencha os valores.
# O ".env" nunca vai pro GitHub (esta pasta ja esta no .gitignore) --
# esses dados sao secretos, nao compartilhe com ninguem.

# URL do projeto Supabase (mesma do catalogo/index.html e do index.html raiz)
SUPABASE_URL=https://zaoyqjzvwuhsqcgigppu.supabase.co

# Service Role Key -- NAO e a anon key do site publico. Pegue em:
# Supabase Dashboard -> seu projeto -> Project Settings -> API ->
# "service_role" (em "Project API keys"). Essa chave da acesso total ao
# banco, por isso so pode ficar aqui neste arquivo local, nunca no site
# nem no repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Caminho do executavel do OrcaSlicer nesta maquina (usado so pelo
# fatiamento 100% automatico via linha de comando, que hoje nao tem
# botao na tela -- deixado aqui pra caso volte a ser usado no futuro).
ORCA_PATH=C:\Program Files\OrcaSlicer\orca-slicer.exe

# Caminho do fatiador que abre quando clica "Abrir no Fatiador" no
# sistema -- e o Bambu Studio, que e o que o Rafa 3D usa no dia a dia.
SLICER_APP_PATH=C:\Program Files\Bambu Studio\bambu-studio.exe

# De quanto em quanto tempo o agente confere se tem pedido de fatiamento
# novo, em milissegundos. 5000 = a cada 5 segundos.
POLL_INTERVAL_MS=5000

# Chave da API da Anthropic -- so precisa se voce quiser usar o botao
# "Analisar com IA" (a colinha de configuracao). Pegue em:
# console.anthropic.com -> Settings -> API Keys -> Create Key.
# Sem isso preenchido, o agente continua fatiando normalmente, so a
# analise por IA fica desligada.
ANTHROPIC_API_KEY=

# Normalmente nao precisa mexer aqui -- e o modelo usado pra analisar a
# miniatura da peca. Sonnet 5 da uma ficha tecnica bem mais completa que
# Haiku; troque para claude-haiku-4-5-20251001 so se quiser priorizar
# custo/velocidade em vez de profundidade de analise.
ANTHROPIC_MODEL=claude-sonnet-5

# Chave da API da Meshy -- so precisa se voce quiser usar o botao "Gerar
# por IA" na aba Projetos (cria o modelo 3D a partir da foto do cliente).
# Pegue em: meshy.ai -> conta -> API. E um servico pago, separado da
# Anthropic. Sem isso preenchido, o resto do sistema continua funcionando
# normal, so a geracao de modelo fica desligada.
MESHY_API_KEY=
