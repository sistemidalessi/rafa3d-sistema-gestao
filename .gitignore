# Instaladores e binários baixados — nunca fazem parte do projeto
*.exe
*.msi
*.dmg
*.AppImage

# Logs soltos (ex: gerados pelo OrcaSlicer na pasta atual sem querer)
*.log
0*.log

# Backups locais de fotos/arquivos que a Claude cria antes de substituir algo
*_old_backup.*
*_backup.*

# Agente de fatiamento automático (slicer-agent): segredos e dependências
# locais nunca vão pro repositório — cada máquina que roda o agente tem
# seu próprio .env preenchido a partir do .env.example.
slicer-agent/.env
slicer-agent/node_modules/
slicer-agent/agent.log
slicer-agent/downloads/

# Configuração local do Claude Code (histórico de permissões de comando) —
# é por máquina/sessão, não faz sentido compartilhar. launch.json (servidor
# de preview local) continua indo pro repo, esse é o único que não vai.
.claude/settings.local.json

# Modelo 3D gerado solto na raiz (sobra de teste do agente ou do fatiador).
# Arquivo de peca nao mora aqui: o do catalogo vai pro Storage do Supabase,
# e o que o agente baixa fica em slicer-agent/downloads, ja ignorado.
/*.3mf

# Malhas baixadas pela comparacao Hi3D x Meshy -- sao pesadas e da pra
# gerar de novo a qualquer momento rodando comparar-geradores.js.
slicer-agent/comparacao/
